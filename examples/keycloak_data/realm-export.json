{
    "realm": "invincible-agent",
    "enabled": true,
    "users": [
        {
            "username": "agent-user",
            "enabled": true,
            "email": "agent@example.com",
            "firstName": "Invincible",
            "lastName": "User",
            "credentials": [
                {
                    "type": "password",
                    "value": "password",
                    "temporary": false
                }
            ],
            "realmRoles": [
                "user"
            ],
            "clientRoles": {
                "cortex-ui": [
                    "user"
                ]
            }
        }
    ],
    "clients": [
        {
            "clientId": "cortex-ui",
            "enabled": true,
            "publicClient": true,
            "directAccessGrantsEnabled": true,
            "redirectUris": [
                "http://localhost:5173/*",
                "http://localhost:8000/*"
            ],
            "webOrigins": [
                "*"
            ]
        },
        {
            "clientId": "iagent-review-starter",
            "enabled": true,
            "publicClient": false,
            "serviceAccountsEnabled": true,
            "standardFlowEnabled": false,
            "directAccessGrantsEnabled": false,
            "secret": "sandbox-review-starter-secret",
            "protocolMappers": [
                {
                    "name": "authz-id-svc",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-hardcoded-claim-mapper",
                    "config": {
                        "claim.name": "email",
                        "claim.value": "svc:review-starter",
                        "jsonType.label": "String",
                        "access.token.claim": "true",
                        "id.token.claim": "true",
                        "userinfo.token.claim": "true"
                    }
                }
            ]
        }
    ],
    "roles": {
        "realm": [
            {
                "name": "user",
                "description": "General user role"
            },
            {
                "name": "admin",
                "description": "Administrator role"
            }
        ]
    }
}
