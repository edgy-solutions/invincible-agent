# LLM API Keys (Required for BAML and Agents)
OPENAI_API_KEY=your_openai_api_key_here
HF_TOKEN=your_huggingface_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# BAML Logging (Set to debug for more verbosity)
BAML_LOG_LEVEL=info

# Service Discovery (Defaults for Docker Compose)
ONTOLOGY_SVC_URL=http://ontology-service:8084
NEO4J_EXPERT_SVC_URL=http://neo4j-expert:8086
LANGGRAPH_SUPPORT_SVC_URL=http://langgraph-support:8082
PRESENTATION_AGENT_SVC_URL=http://presentation-agent:8087
RESTATE_ANALYST_URL=http://restate-analyst:8081
SWARMS_SCRAPER_URL=http://swarms-scraper:8083
DATAHUB_WRAPPER_URL=http://datahub-wrapper:8085
