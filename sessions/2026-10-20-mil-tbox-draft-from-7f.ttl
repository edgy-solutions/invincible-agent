@prefix mil:  <http://edgy-solutions.com/ontology/mil#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof:  <https://spec.industrialontologies.org/ontology/core/Core/> .

mil:MIL_Ontology a owl:Ontology ;
    rdfs:label "Unified Military Technical Manual Ontology" ;
    rdfs:comment "Bridges S1000D, IADS, and DITA into a single equipment graph. Two orthogonal axes: SOURCE FORMAT (how the document was authored — ingest/provenance concern) and CONTENT KIND (what the document IS — routing concern, derived from the S1000D information code). Routing resolves against the content-kind hierarchy under mil:DataModule; ingest records the source-format class for lineage. An instance carries both: INSTANCE_OF its content kind, plus mil:hasInfoCode / a source-format marker." .
#
# !! rdfs:comment IS THE EMBEDDING. BUILD NOTES BELONG IN `#` COMMENTS, NOT IN A TRIPLE. !!
#
# doc-tools' extractor runs { ?uri skos:definition ?d } UNION { ?uri rdfs:comment ?d }, so a
# class declaring BOTH yields two rows and the Weaviate upsert (deterministic UUID per URI)
# keeps whichever lands last. Verified live 2026-08-15: mro:TechnicalManual's stored
# definition was a BUILD NOTE and its authored skos:definition had been discarded.
#
# `#` comments are not triples and cannot be embedded. Notes below are preserved verbatim;
# they just stop competing to BE the definition.
#

# ===========================================================================
# AXIS 1 — SOURCE FORMAT (ingest provenance; NOT the routing-visible layer)
# These record how a module was authored. They are siblings, distinguished by
# parser/source, and exist for lineage — not for the resolver candidate pool.
# ===========================================================================

mil:DataModule a owl:Class ;
    rdfs:subClassOf iof:InformationContentEntity ;
    rdfs:label "S1000D Data Module" ;
    skos:definition "A unit of technical information authored to the S1000D standard, identified by its Data Module Code (DMC). Root of the content-kind hierarchy below." .

mil:IadsNode a owl:Class ;
    rdfs:subClassOf iof:InformationContentEntity ;
    rdfs:label "IADS XML Node" ;
    skos:definition "A technical information unit authored in the IADS XML format. Source-format class for ingest provenance." .

mil:DitaNode a owl:Class ;
    rdfs:subClassOf iof:InformationContentEntity ;
    rdfs:label "DITA Task or Topic" ;
    skos:definition "A technical information unit authored as a DITA task or topic. Source-format class for ingest provenance." .

# ===========================================================================
# AXIS 2 — CONTENT KIND (the ROUTING-VISIBLE hierarchy)
# Subclasses of mil:DataModule, distinguished by WHAT THE CONTENT IS, derived
# deterministically from the S1000D information code (mil:hasInfoCode). These
# are the subjects user questions resolve to. A kind enters the resolver
# candidate pool only when a verb is typed against it (Wave-3 discipline);
# bulk-declared here from the standardized info-code taxonomy, held out of the
# pool until verb coverage exists.
# ===========================================================================

# NOTE FOR DescriptiveDataModule — was: Routing subject for descriptive/'what is' queries
#   about equipment.
mil:DescriptiveDataModule a owl:Class ;
    rdfs:subClassOf mil:DataModule ;
    rdfs:label "Descriptive Data Module" ;
    skos:definition "Describes what a system, subsystem, or item IS — function, construction, operation. S1000D information code family 0xx." .

# NOTE FOR ProcedureDataModule — was: Routing subject for 'how do I', step, and procedure
#   queries. Maps to the :Procedure / :ManufacturingStep instance labels (see ingest
#   mapping).
mil:ProcedureDataModule a owl:Class ;
    rdfs:subClassOf mil:DataModule ;
    rdfs:label "Procedure Data Module" ;
    skos:definition "Describes HOW to perform a task — maintenance, operation, servicing, assembly. S1000D information code families 2xx (operation) and 5xx/7xx (maintenance/repair)." .

# NOTE FOR FaultIsolationDataModule — was: Routing subject for diagnostic / 'why is it
#   broken' / 'how do I find the fault' queries. The diagnostic lane.
mil:FaultIsolationDataModule a owl:Class ;
    rdfs:subClassOf mil:DataModule ;
    rdfs:label "Fault Isolation Data Module" ;
    skos:definition "Describes how to detect, isolate, and correct a fault — symptoms, fault trees, troubleshooting. S1000D information code family 4xx." .

# NOTE FOR IllustratedPartsDataModule — was: Routing subject for parts-breakdown, IPD, and
#   'what parts make up X' queries.
mil:IllustratedPartsDataModule a owl:Class ;
    rdfs:subClassOf mil:DataModule ;
    rdfs:label "Illustrated Parts Data Module" ;
    skos:definition "Catalogs the parts of an assembly with illustrations and part numbers — the IPD/IPC. S1000D information code family 9xx." .

# NOTE FOR Diagram — was: Routing subject (or output) for diagram/figure queries.
mil:Diagram a owl:Class ;
    rdfs:subClassOf mil:DataModule ;
    rdfs:label "Diagram" ;
    skos:definition "A visual technical illustration — schematic, wiring diagram, exploded view, callout — attached to a data module." .

# ===========================================================================
# MATERIAL ARTIFACTS (instances cross-linked to data modules)
# ===========================================================================

mil:Tool a owl:Class ;
    rdfs:subClassOf iof:MaterialArtifact ;
    rdfs:label "Support Equipment or Tool" ;
    skos:definition "A tool or item of support equipment required to perform a procedure." .

mil:Part a owl:Class ;
    rdfs:subClassOf iof:MaterialArtifact ;
    rdfs:label "Spare Part" ;
    skos:definition "A spare or replacement part referenced by a data module." .

# ===========================================================================
# OBJECT PROPERTIES — the instance cross-links.
# These are the join keys the composition layer (ADR-0011) will walk:
# "what procedure covers replacing part X" traverses mil:hasPart;
# "what does this procedure require" traverses mil:requiresTool.
# Typed now so composition is over named predicates, not hand-waved edges.
# ===========================================================================

mil:requiresTool a owl:ObjectProperty ;
    rdfs:domain iof:InformationContentEntity ;
    rdfs:range mil:Tool ;
    rdfs:label "Requires Tool" ;
    skos:definition "Relates a data module (typically a procedure) to a tool or support equipment its steps require." .

mil:hasPart a owl:ObjectProperty ;
    rdfs:domain iof:InformationContentEntity ;
    rdfs:range mil:Part ;
    rdfs:label "Has Spare Part" ;
    skos:definition "Relates a data module to a spare part it references or whose replacement it covers." .

# ===========================================================================
# DATATYPE PROPERTIES
# mil:hasInfoCode is the DETERMINISTIC CLASSIFICATION KEY — the ingest path
# reads it to assign the Axis-2 content kind. No LLM in that path.
# ===========================================================================

mil:hasInstructionText a owl:DatatypeProperty ;
    rdfs:domain iof:InformationContentEntity ;
    rdfs:range xsd:string ;
    rdfs:label "Instruction Text" ;
    skos:definition "The authored text of one instruction a maintainer performs - the body of a procedural step. Position in the procedure is not carried here; it is held by the rdf:List the step hangs from." .

mil:hasWarning a owl:DatatypeProperty ;
    rdfs:domain iof:InformationContentEntity ;
    rdfs:range xsd:string ;
    rdfs:label "Safety Warning" ;
    skos:definition "A safety warning, caution or note authored against a data module or one of its steps, carried verbatim as the source prints it. A warning is never summarised or merged across steps." .

mil:hasSNS a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Standard Numbering System Code" ;
    skos:definition "The S1000D Standard Numbering System code identifying the system/subsystem the module applies to. Used for equipment cross-linking." .

mil:hasInfoCode a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "S1000D Information Code" ;
    skos:definition "The S1000D information code. The DETERMINISTIC source of the Axis-2 content-kind classification: 0xx -> Descriptive, 2xx/5xx/7xx -> Procedure, 4xx -> FaultIsolation, 9xx -> IllustratedParts. Read at ingest to assign INSTANCE_OF; no model inference." .
# ===========================================================================
# S1000D CONTENT STRUCTURE (doc-tools parsers; added 2026-10-17)
# Domain/range below are MEASURED off the emitted graph, not inferred from the
# property names. Where the emitted subject classes are disjoint, rdfs:domain
# is deliberately OMITTED rather than narrowed to a false one.
# ===========================================================================

mil:Figure a owl:Class ;
    rdfs:subClassOf iof:InformationContentEntity ;
    rdfs:label "Technical Illustration" ;
    skos:definition "An illustration carried by a data module, identified by its Illustration Control Number (ICN) where one is authored. Carries the resolved artwork URL and, for an illustrated parts module, the catalog items its hotspots index." .

mil:CatalogItem a owl:Class ;
    rdfs:label "Illustrated Parts Catalog Item" ;
    skos:definition "One line of an illustrated parts data module: a catalog sequence number resolving to a part, with the quantity required and the manufacturer code. The unit a parts-list question resolves to." .

mil:FaultCode a owl:Class ;
    rdfs:label "Fault Code" ;
    skos:definition "A diagnostic fault code declared by a fault isolation data module, carrying its code value and the fault text. The subject a fault-isolation question resolves to." .

mil:PlanningInterval a owl:Class ;
    rdfs:label "Maintenance Planning Interval" ;
    skos:definition "A scheduled-maintenance threshold: the value and unit at which a task becomes due, as authored in a maintenance planning data module." .

mil:ProceduralStep a owl:Class ;
    rdfs:subClassOf iof:InformationContentEntity ;
    rdfs:label "Procedural Step" ;
    skos:definition "One step of a procedure, carrying its instruction text. Position in the procedure is held by the rdf:List that mil:hasProcedureSteps points at, never by a property of the step itself." .

mil:WorkPackage a owl:Class ;
    rdfs:subClassOf mil:DataModule ;
    rdfs:label "MIL-STD-40051 Work Package" ;
    skos:definition "A unit of technical information authored to MIL-STD-40051 as a work package. Co-typed with mil:DataModule so a cross-standard query reaches both." .

# ----- the rdf:List-valued procedures property (ruling 3) -----
# The list CELLS are deliberately untyped in the emitted data: a walk reaches
# them by rdf:rest*/rdf:first, which needs no type. So this range is a
# declaration about the structure, and an instance-type validator will NOT
# confirm it. Cells are URIs, never blank nodes, because the instance-graph
# write ships the graph as SPARQL INSERT DATA, which mints a fresh blank node
# per execution and would duplicate the whole list on every re-ingest.
mil:hasProcedureSteps a owl:ObjectProperty ;
    rdfs:domain mil:ProcedureDataModule ;
    rdfs:range rdf:List ;
    rdfs:label "Has Procedure Steps" ;
    skos:definition "Relates a procedure data module to the ordered list of its steps, as an rdf:List. Order is the list, read with rdf:rest*/rdf:first. There is no step-index property: none was ever declared in this vocabulary, which is why order is modelled as a list." .

mil:hasStepText a owl:DatatypeProperty ;
    rdfs:domain mil:ProceduralStep ;
    rdfs:range xsd:string ;
    rdfs:label "Step Instruction Text" ;
    skos:definition "The instruction text of one procedural step, with authoring line wraps collapsed. Text of a nested step is folded into its enclosing step." .

# ----- fault isolation -----
mil:hasFaultCode a owl:ObjectProperty ;
    rdfs:domain mil:FaultIsolationDataModule ;
    rdfs:range mil:FaultCode ;
    rdfs:label "Has Fault Code" ;
    skos:definition "Relates a fault isolation data module to a fault code it declares." .

mil:hasFaultCodeValue a owl:DatatypeProperty ;
    rdfs:domain mil:FaultCode ;
    rdfs:range xsd:string ;
    rdfs:label "Fault Code Value" ;
    skos:definition "The code value itself, kept as a literal so cross-document identity stays recoverable by joining on it: fault-code subjects are document-scoped." .

mil:hasFaultCodeText a owl:DatatypeProperty ;
    rdfs:domain mil:FaultCode ;
    rdfs:range xsd:string ;
    rdfs:label "Fault Code Text" ;
    skos:definition "The authored description of what the fault code means." .

# ----- maintenance planning -----
mil:hasPlanningInterval a owl:ObjectProperty ;
    rdfs:domain mil:DataModule ;
    rdfs:range mil:PlanningInterval ;
    rdfs:label "Has Planning Interval" ;
    skos:definition "Relates a data module to a scheduled-maintenance interval it authorises." .

mil:hasIntervalValue a owl:DatatypeProperty ;
    rdfs:domain mil:PlanningInterval ;
    rdfs:range xsd:string ;
    rdfs:label "Interval Value" ;
    skos:definition "The threshold value at which the task becomes due. A literal, not a number: the authored form is kept verbatim." .

mil:hasIntervalUnit a owl:DatatypeProperty ;
    rdfs:domain mil:PlanningInterval ;
    rdfs:range xsd:string ;
    rdfs:label "Interval Unit" ;
    skos:definition "The unit of measure the interval value is expressed in, as authored." .

# ----- illustrated parts -----
# NO rdfs:domain: emitted with BOTH a mil:DataModule and a mil:Figure subject
# (always the module, so a walk need not hop the figure; also the figure when
# there is one). A single domain here would be a false statement.
mil:hasCatalogItem a owl:ObjectProperty ;
    rdfs:range mil:CatalogItem ;
    rdfs:label "Has Catalog Item" ;
    skos:definition "Relates an illustrated parts data module, and the figure it appears on, to one catalog line." .

mil:hasItemNumber a owl:DatatypeProperty ;
    rdfs:domain mil:CatalogItem ;
    rdfs:range xsd:string ;
    rdfs:label "Catalog Item Number" ;
    skos:definition "The catalog sequence or item number identifying this line within its figure." .

mil:hasQuantity a owl:DatatypeProperty ;
    rdfs:domain mil:CatalogItem ;
    rdfs:label "Required Quantity" ;
    skos:definition "How many of the part this catalog line requires. Typed xsd:integer when the authored value parses as one and kept as the authored literal when it does not, so an unparseable quantity is visible rather than coerced." .

mil:hasManufacturerCode a owl:DatatypeProperty ;
    rdfs:domain mil:CatalogItem ;
    rdfs:range xsd:string ;
    rdfs:label "Manufacturer Code" ;
    skos:definition "The manufacturer or CAGE code authored against this catalog line." .

# NO rdfs:domain: emitted against mil:CatalogItem, mil:Part AND mil:Tool, and
# mil:Tool is deliberately not a subclass of mil:Part, so there is no common
# superclass to key on.
mil:hasPartNumber a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "Part Number" ;
    skos:definition "The part number as authored, kept as a literal so cross-document identity stays recoverable by joining on it: part and tool subjects are document-scoped to stop two documents fusing into one node." .

# ----- figures and artwork -----
mil:hasFigure a owl:ObjectProperty ;
    rdfs:domain mil:DataModule ;
    rdfs:range mil:Figure ;
    rdfs:label "Has Figure" ;
    skos:definition "Relates a data module to an illustration it carries." .

mil:hasICN a owl:DatatypeProperty ;
    rdfs:domain mil:Figure ;
    rdfs:range xsd:string ;
    rdfs:label "Illustration Control Number" ;
    skos:definition "The authored ICN of the illustration. Absent when the graphic carries only a board number, which is NOT an ICN and is never substituted for one." .

mil:hasURL a owl:DatatypeProperty ;
    rdfs:domain mil:Figure ;
    rdfs:range xsd:string ;
    rdfs:label "Artwork URL" ;
    skos:definition "The resolved location of the artwork. Emitted only when it resolves: an ICN is never dressed up as a URL." .

mil:hasHotspotId a owl:DatatypeProperty ;
    rdfs:domain mil:CatalogItem ;
    rdfs:range xsd:string ;
    rdfs:label "Hotspot Identifier" ;
    skos:definition "The identifier joining a catalog line to the clickable region of the artwork that indexes it. Every id emitted is present in the sibling SVG; the converse does not hold, since a graphic may carry hotspots no catalog line references." .

mil:renderingOrigin a owl:DatatypeProperty ;
    rdfs:domain mil:Figure ;
    rdfs:range xsd:string ;
    rdfs:label "Rendering Origin" ;
    skos:definition "Where the artwork reference came from, including the explicit value unresolved when it could not be resolved at all. An unresolved figure says so rather than defaulting to something that looks resolved." .

# ----- cross-references -----
mil:refersToDataModule a owl:ObjectProperty ;
    rdfs:domain mil:DataModule ;
    rdfs:range mil:DataModule ;
    rdfs:label "Refers To Data Module" ;
    skos:definition "A cross-reference from one data module to another, assembled with the same canonicalizer on both sides so the target connects to the subject of the referenced module. BREX self-references in the ident and status section are excluded: unfiltered they inflate this edge count from 5 to 11 over the six MRAD modules." .
