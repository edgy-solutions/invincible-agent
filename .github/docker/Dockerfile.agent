# STAGE 1: BUILDER
FROM python:3.12-slim-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 \
UV_LINK_MODE=copy \
PYTHONUNBUFFERED=1 \
UV_PROJECT_ENVIRONMENT=/app/.venv \
UV_CACHE_DIR=/root/.cache/uv
WORKDIR /app
ARG AGENT_DIR
COPY ${AGENT_DIR}/pyproject.toml* ${AGENT_DIR}/uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv \
if [ -f "pyproject.toml" ]; then \
uv sync --locked --no-dev --no-install-project --compile-bytecode && \
uv pip install packaging setuptools wheel; \
fi
COPY ${AGENT_DIR}/ /app/
COPY baml_shared/baml_client/baml_client/ /app/baml_client/
# Telemetry shim + mesh mapping (ADR-0038). MUST land at /app (the flattened
# service root, on sys.path) so every service's `from telemetry import ...`
# resolves to the provenance-telemetry-backed shim instead of its ImportError
# no-op fallback. The shim reads telemetry-mapping.yaml from its own dir (/app).
# Copied for every fleet service (two small files), like baml_client above.
COPY baml_shared/telemetry.py /app/telemetry.py
COPY baml_shared/telemetry-mapping.yaml /app/telemetry-mapping.yaml
# Git-asserted process definitions (ADR-0029). BAKED IN, not mounted: the gate
# tests executor-plus-YAML as ONE unit and the deploy must ship that unit;
# definitions have no validate->reconcile->readback discipline the way Topaz
# configs do; and hot-swap is a property a process should not have until it
# earns its own validation pipeline. Lands beside the FLATTENED service dir,
# which is why the registry's container candidate is /app/policy/workflows.
# Copied for every fleet service (two small YAMLs) — a conditional COPY would
# buy nothing and cost a build-arg branch.
COPY policy/workflows/ /app/policy/workflows/
# ADMISSION POLICY, baked for the SAME reason as the definitions above (ADR-0034 phase
# 1.3). ReviewStarter now READS this table to choose which workflow to start, so the file
# must exist in engine-a's image — before this it did not (verified on the running pod:
# /app/policy contained only workflows/), and load_trust_table would have raised
# "refusing to infer a policy" on every start. Baked rather than mounted so the executor
# and the policy it enforces ship as ONE unit, and so the content hash riding into every
# decision record names something reproducible.
COPY policy/trust_table.yaml /app/policy/trust_table.yaml
# VENDOR ALIASES (phase 1.3 normalization) — canonical-form resolution data for
# format_fingerprint(), which BOTH runtimes compute. If this file reached one image and
# not the other, the two would canonicalise differently and produce two trust keys for one
# vendor — precisely the split it exists to close, reintroduced by a packaging gap. The
# Dagster image already carries the whole policy/ directory; this line is what keeps the
# fleet image in step.
#
# NB the per-file COPY is itself the fragile part: the next shared-policy file will need
# another line here, and forgetting it fails SILENTLY (different values, no error). Copying
# the whole directory is the durable fix and is filed with the normalization item.
COPY policy/vendor_aliases.yaml /app/policy/vendor_aliases.yaml
# RATIFIED GRAPH ROWS (ADR-0046). engine-lg admits a graph ONLY from a row here, so
# without this line the host ships with its graph MODULES and none of its contracts:
# it boots, admits zero graphs, registers zero verbs and answers healthy. That is
# exactly what happened on rev 106, and the comment four lines up had already named
# the mechanism — "the per-file COPY is itself the fragile part: the next
# shared-policy file will need" this. policy/graphs/ was that next file.
#
# BAKED IS RIGHT FOR TODAY AND WRONG THE MOMENT AN OVERLAY EXISTS. ADR-0036 has the
# host read the COMPOSED directory (seed + work-side overlay); a baked seed means
# engine-lg silently ignores every overlay, so a customer's tombstone deleting a
# seeded graph would leave it registered. The composed dir must be MOUNTED and
# GRAPH_POLICY_DIR pointed at it before any overlay is real. Filed, not built.
COPY policy/graphs/ /app/policy/graphs/
# THE OVERLAY LAYER (ADR-0036), and this is the THIRD time the comment twenty lines
# up has come true. It said "the next shared-policy file will need another line here,
# and forgetting it fails SILENTLY". policy/graphs/ was the second — rev 106 shipped
# engine-lg with its graph MODULES and none of its contracts, booting healthy with
# zero graphs registered. policy/overlays/ is the third.
#
# The failure here would be the quietest yet: a missing overlay directory does not
# error, it composes to SILENCE. GRAPH_OVERLAY_DIRS would point at a path that is not
# there, the host would compose the seed alone, and every deployment would read as
# "no domain graphs declared" whether or not any were. The same shape took 18 live
# task rows from actionable to dead in a gate written the same day.
#
# cortex-bff does NOT need a line: its image copies the whole repo (see its own
# comment above), which is why /app/policy is complete there and per-file here.
COPY policy/overlays/ /app/policy/overlays/
# THE RATIFIED RISK MATRIX (ADR-0051 §2), and this is the FOURTH time the comment
# above has come true — it said "the next shared-policy file will need another line
# here, and forgetting it fails SILENTLY". It did, and this one failed LOUDLY but
# LATE: engine-safety came up healthy, registered, routed at 0.98, and raised
# `FileNotFoundError: /app/safety_risk_matrix.ttl` ON THE FIRST REAL CALL.
#
# WHY IT WAS MISSED, AND IT IS NOT THE OBVIOUS REASON. The TTL is also PRIMED into
# Jena, so "the ontologies are primed, not shipped" is true — and irrelevant here.
# `matrix.py` parses this file FROM DISK to resolve severity x probability to a risk
# level; the primed copy serves the graph and no code path reads it for that. A file
# can be correctly primed AND required on disk, and the word "ontology" hides the
# difference.
#
# SO THE RULE IS ABOUT THE READ, NOT THE FILETYPE: an engine's IMAGE must carry every
# file that engine OPENS, whatever else also holds its contents. The engine's own
# layout seal asserted the opposite in its fixture — "the TTLs are NOT copied,
# deliberately" — which made this absence look designed and kept it green.
#
# Unconditional, like the two policy lines above and for the stated reason: one small
# file in eleven images costs less than a conditional COPY that fails silently for the
# twelfth engine that needs one.
COPY setup/ontologies/safety_risk_matrix.ttl /app/safety_risk_matrix.ttl
# THE FOURTH, and the comment above has now come true three times in a row, which is
# the argument for stopping counting and shipping the directory. ADR-0053 §2 method
# rows: the EAC formulas as ratified DATA, so a figure carrying `method: CPI` under §5
# names something checkable rather than a label.
#
# SHIPPED ONE RELEASE AHEAD OF ITS CONSUMER, deliberately. Nothing imports the method
# registry at runtime yet. If this COPY and the import landed together and the COPY
# were the half that slipped, the finance engine would not boot at all -- so the data
# rides in first and the runtime starts depending on it next.
COPY policy/measures/ /app/policy/measures/
# ── THE COST PACKAGE BUILDER AND ITS PINNED RUNTIME ────────────────────────
#
# `cost_agent.measures.package_export` builds a self-contained artifact from the
# package builder plus the pinned Pyodide runtime. Both lived ONLY in a developer
# checkout, so a deployed engine refused the work by name — correctly, and
# permanently. This is what makes the refusal stop being the only answer.
#
# THE BUILDER IS UNCONDITIONAL (one small module). THE RUNTIME IS NOT: it is 14 MB,
# and multiplying that across eleven images buys nothing for the ten that never call
# the export. A COPY needs a source that EXISTS, so the optional payload is a
# build-arg pointing at `.docker-empty/` by default and at the fetched runtime for
# cost-agent alone.
#
# THE RUNTIME IS FETCHED IN CI, NOT COMMITTED. `.pyodide-cache/` is gitignored, so
# nothing in the repo could be copied — the "on disk and undeclared" shape, one layer
# over from a TTL absent from the prime manifest. The builder already knows how:
# `--fetch-runtime` pulls the version pinned in `PYODIDE_VERSION`.
COPY scripts/build_cost_package.py /app/scripts/build_cost_package.py
ARG PACKAGE_RUNTIME_SRC=.docker-empty
COPY ${PACKAGE_RUNTIME_SRC}/ /app/.pyodide-cache/
COPY agent_fleet/llm_utils.py /app/llm_utils.py
COPY agent_fleet/utils/ /app/utils/
COPY agent_fleet/core/ /app/core/
RUN --mount=type=cache,target=/root/.cache/uv \
if [ -f "pyproject.toml" ]; then \
uv sync --locked --no-dev --no-install-project --compile-bytecode && \
uv pip install packaging setuptools wheel; \
fi

# ------------------------------------------------------------------
# Pre-download offline-required NLP models.
# The target cluster has no internet access at runtime; mem0ai[nlp]
# otherwise tries to fetch spaCy models from raw.githubusercontent.com
# on first /search and crashes the request. We pre-bake the model
# into the venv during build (where the CI runner does have internet)
# so the runtime image is truly self-contained.
#
# Guarded by spacy availability — services that don't depend on
# mem0ai[nlp] (most of the fleet) skip this step at no cost.
# ------------------------------------------------------------------
RUN if /app/.venv/bin/python -c "import spacy" 2>/dev/null; then \
echo "Pre-downloading spaCy en_core_web_sm for offline runtime..." && \
/app/.venv/bin/python -m spacy download en_core_web_sm; \
else \
echo "spaCy not installed for this service — skipping model bake."; \
fi

# STAGE 2: SECURE RUNNER
FROM python:3.12-slim-bookworm
# Create appuser with an explicit home directory inside /app
RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser

# PYTHONPATH includes /app/src first so cortex-bff's `from
# src.iagent.gateway import app` resolves to /app/src/iagent/
# when building with AGENT_DIR=. (whole-repo copy). Other agent
# fleet services don't have /app/src/ at all so this is a no-op
# for them.
ENV PYTHONUNBUFFERED=1 \
PYTHONDONTWRITEBYTECODE=1 \
HOME=/app \
PYTHONPATH="/app/src:/app:/app/.venv/lib/python3.12/site-packages:${PYTHONPATH}" \
PATH="/app/.venv/bin:$PATH" \
# Force swarms and other libs to use /app instead of /home/appuser
SWARMS_WORKSPACE=/app/agent_workspace \
XDG_CACHE_HOME=/app/.cache

WORKDIR /app
RUN mkdir -p /app/agent_workspace /app/.cache && chown -R appuser:appuser /app

ARG PORT=8080
ENV PORT=${PORT}
# MAIN_MODULE is the Python module path (dotted) that exports
# the FastAPI `app`. Defaults to `main` (services with main.py
# at /app/main.py). cortex-bff overrides to
# `agent_fleet.cortex_bff.main` because its main.py lives at
# /app/agent_fleet/cortex_bff/main.py (the build pulls the whole
# repo). Without this override the runner CMD's hardcoded
# `main:app` fails for cortex-bff with "Could not import module 'main'".
ARG MAIN_MODULE=main
ENV MAIN_MODULE=${MAIN_MODULE}
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

# Copy everything from builder with appuser ownership
# ── THE IMAGE CARRIES ITS OWN COMMIT ───────────────────────────────────────
# Baked at BUILD time, not injected by the chart. A tag in the pod spec is a
# claim about what was requested; under `:latest` it is not even that. This is
# what the running process can be asked, and it cannot drift from the code in
# the layer beside it. `scripts/version_census.py` reads it from every service
# and diffs against a git ref, which is how "is it current?" stops being a
# person squinting at pod age.
ARG GIT_SHA=unknown
ENV IAGENT_GIT_SHA=$GIT_SHA
COPY --from=builder --chown=appuser:appuser /app /app

USER appuser
CMD ["/bin/sh", "-c", "\
if [ -f '/app/.venv/bin/hypercorn' ]; then \
echo \"Starting with Hypercorn (HTTP/2 enabled) — module ${MAIN_MODULE}:app...\" && \
/app/.venv/bin/python -m hypercorn ${MAIN_MODULE}:app --bind 0.0.0.0:${PORT}; \
else \
echo \"Starting with Uvicorn — module ${MAIN_MODULE}:app...\" && \
/app/.venv/bin/python -m uvicorn ${MAIN_MODULE}:app --host 0.0.0.0 --port ${PORT}; \
fi"]
