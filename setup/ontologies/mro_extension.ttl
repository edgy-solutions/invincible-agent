@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix iof-construct: <https://spec.industrialontologies.org/ontology/construct/> .
@prefix mro:   <https://spec.industrialontologies.org/ontology/maintenance/MaintenanceReferenceOntology/> .

<http://internal/mro> a owl:Ontology ;
    rdfs:label "MRO domain extension (TechnicalManual, Diagram, ProcedureStep)" ;
    rdfs:comment "Thin extension declaring the concrete user-facing nouns needed for routing: mro:TechnicalManual (manual/document subject), mro:Diagram (procedure-attached visual), mro:ProcedureStep (work-instruction step). Subclass bridges to iof-construct so the compat-reasoner can walk subClassOf to find verbs typed against the IOF backbone. Authored as the Step 1 substrate for ADR-0019 verb re-typing — pairs with mesh:retrieveKnowledge being re-typed to mro:TechnicalManual and mesh:queryKnowledgeGraph re-typed to mro:WorkInstruction (which already exists in Neo4j)." .

# ---------------------------------------------------------------------------
# Concrete domain nouns
# ---------------------------------------------------------------------------
#
# !! rdfs:comment IS THE EMBEDDING. BUILD NOTES BELONG IN `#` COMMENTS, NOT IN A TRIPLE. !!
#
# doc-tools' extractor runs { ?uri skos:definition ?d } UNION { ?uri rdfs:comment ?d }, so a
# class declaring BOTH yields two rows and the Weaviate upsert (deterministic UUID per URI)
# keeps whichever lands last. Verified live on sandbox 2026-08-15 — mro:TechnicalManual's
# stored `definition` was:
#
#     "Required by the matrix query 'Search the technical manuals for fuel system
#      diagnostics' which currently mis-resolves to mesh:GraphQuery."
#
# The authored skos:definition was DISCARDED and a build note became the class's entire
# semantic representation. Which also made the matrix row circular: the query the test
# asserts on was inside the text the test retrieves.
#
# `#` comments are not triples, so they cannot be embedded. Every note below was previously
# an rdfs:comment; nothing is lost, it just stops competing to BE the definition.
#
# NOTE FOR mro:TechnicalManual — was: "Required by the matrix query 'Search the technical
# manuals for fuel system diagnostics' which currently mis-resolves to mesh:GraphQuery."
mro:TechnicalManual a owl:Class ;
    rdfs:subClassOf iof-construct:DescriptiveInformationContentEntity ;
    rdfs:label "Technical Manual" ;
    skos:definition "A document conveying descriptive technical information about a system, asset, or procedure — operations manuals, maintenance manuals, troubleshooting guides, and reference documentation. Routable subject for manual-text search verbs (mesh:retrieveKnowledge against Engine W)." .

# NOTE FOR mro:Diagram — was: "Optional output type for mesh:queryKnowledgeGraph verb
# covering 'Describe procedure TEST-1234 and show me its diagram'. Generic
# mesh:GraphExpertResponse output works without this; declaring it enables stricter output
# typing if desired."
mro:Diagram a owl:Class ;
    rdfs:subClassOf iof-construct:DescriptiveInformationContentEntity ;
    rdfs:label "Diagram" ;
    skos:definition "A visual representation attached to a work instruction or technical manual — schematics, exploded views, callouts, and procedural illustrations." .

# NOTE FOR mro:ProcedureStep — was: "Optional output type for mesh:queryKnowledgeGraph
# against mro:WorkInstruction. Generic mesh:GraphExpertResponse output works without this."
mro:ProcedureStep a owl:Class ;
    rdfs:subClassOf iof-construct:DescriptiveInformationContentEntity ;
    rdfs:label "Procedure Step" ;
    skos:definition "A single ordered action within a maintenance procedure or work instruction — pre-conditions, action, verification." .
