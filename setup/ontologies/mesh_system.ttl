@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix mesh: <http://invincible-agent/mesh#> .

# =============================================================================
# mesh: system ontology — platform-level concepts that ADR-0004's predicate
# graph emits as input/output URIs on tool registrations. ADR-0019 §6 makes
# them real :OntologyClass nodes with provenance so they are not phantoms.
# =============================================================================
#
# Two top-level roots:
#   - mesh:Request   — anything an engine accepts as input
#   - mesh:Response  — anything an engine produces as output
#
# Both subclass prov:Entity since PROV-O's wasDerivedFrom is the lineage
# relation the catalog tools rely on.
# =============================================================================

mesh:Request a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Request" ;
  rdfs:comment "Abstract parent of platform request shapes — anything an engine accepts as input." .

mesh:Response a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Response" ;
  rdfs:comment "Abstract parent of platform response shapes — anything an engine produces as output." .

# -----------------------------------------------------------------------------
# Request shapes (inputs)
# -----------------------------------------------------------------------------

mesh:AgentTask a owl:Class ;
  rdfs:subClassOf mesh:Request ;
  rdfs:label "Agent Task" ;
  rdfs:comment "A multi-step task delegated to a smolagents CodeAgent loop (Engine A)." .

mesh:KnowledgeQuery a owl:Class ;
  rdfs:subClassOf mesh:Request ;
  rdfs:label "Knowledge Query" ;
  rdfs:comment "A retrieval request against a manual / document corpus (Engine W)." .

mesh:GraphQuery a owl:Class ;
  rdfs:subClassOf mesh:Request ;
  rdfs:label "Graph Query" ;
  rdfs:comment "A request for the knowledge graph expert (Engine E) to answer using execute_cypher / search_manual_text / get_graph_schema." .

mesh:CatalogAssetQuery a owl:Class ;
  rdfs:subClassOf mesh:Request ;
  rdfs:label "Catalog Asset Query" ;
  rdfs:comment "Identifies a specific catalog asset (dataset, dashboard) by name — input shape for catalog-asset-level verbs (describeAsset, traceLineage, lookupOwnership, ...)." .

mesh:CatalogScopeQuery a owl:Class ;
  rdfs:subClassOf mesh:Request ;
  rdfs:label "Catalog Scope Query" ;
  rdfs:comment "Defines a scope (domain / owner / tag) without naming a single asset — input shape for enumerateCatalog." .

mesh:DatasetAnalysisRequest a owl:Class ;
  rdfs:subClassOf mesh:Request ;
  rdfs:label "Dataset Analysis Request" ;
  rdfs:comment "Input shape for analyzeDataset — names a dataset and the analytical question." .

# DEFINITIONS ARE RETRIEVAL INPUT — no example catalogue here (2026-08-19).
# The previous comment listed `gold.sales.revenue_summary`, `TEST-1234`, `'Customer 360'` — the
# SAME list, same order, as contracts.baml's `instance_identifier` field description. Two masters
# for one vocabulary, neither referencing the other, and the BAML copy is the one that drives
# extraction. Examples of identifiers are also what make every identifier-shaped token resemble
# this class, which is the recall bias `2f617fd` removed elsewhere.
#
# The last sentence is the load-bearing one: it states the identifier-vs-content-word
# distinction on the class the extraction path types against, which is the half the matcher
# gate enforces structurally (segment specificity, instance_resolution.py).
mesh:InstanceIdentifier a owl:Class ;
  rdfs:subClassOf mesh:Request ;
  rdfs:label "Instance Identifier" ;
  rdfs:comment "A token that names one specific individual rather than a kind of thing. Input shape for the mesh:resolveInstance routing pre-step: providers match it against their own catalogues and the authoritative answer overrides the class guess. Distinguished from a content word that merely appears in an asset's name. The lexical SHAPE of the token never decides the class — only providers do." .

mesh:InstanceResolution a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Instance Resolution" ;
  rdfs:comment "The provider's answer to a mesh:resolveInstance lookup: a (possibly empty) list of candidate instances, each with its class URI, label, identity (typically a URN), and the provider's relevance score. An empty list is a first-class answer — providers MUST abstain below their own relevance floor rather than return least-bad matches. Output shape for mesh:resolveInstance. The router consumes the candidate list with a decision table (exact match / fuzzy-unanimous-class / fuzzy-mixed-class abstain / empty fall-through) and only the class is used to set the routing subject; the identity flows downstream as a hint for the executing engine to re-verify against its own store." .

# -----------------------------------------------------------------------------
# Response shapes (outputs)
# -----------------------------------------------------------------------------

mesh:AgentResponse a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Agent Response" ;
  rdfs:comment "The final output of a smolagents CodeAgent run." .

mesh:GraphExpertResponse a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Graph Expert Response" ;
  rdfs:comment "The output of an Engine E smolagents loop over Neo4j." .

mesh:KnowledgeRetrievalResponse a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Knowledge Retrieval Response" ;
  rdfs:comment "The output of an Engine W Weaviate hybrid retrieval." .

mesh:DatasetAnalysisReport a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Dataset Analysis Report" ;
  rdfs:comment "Structured analytical output (profile, statistics, anomaly indicators) from analyzeDataset." .

mesh:AssetProfile a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Asset Profile" ;
  rdfs:comment "Profile of a single catalog asset returned by describeAsset (owner, tags, schema summary, freshness)." .

mesh:CatalogListing a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Catalog Listing" ;
  rdfs:comment "Flat list of catalog assets returned by enumerateCatalog." .

mesh:OwnershipFact a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Ownership Fact" ;
  rdfs:comment "Output of lookupOwnership: owner identity (email, team) plus ownership timestamp." .

mesh:LineageTopology a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Lineage Topology" ;
  rdfs:comment "Upstream/downstream lineage chain returned by traceLineage, derived from prov:wasDerivedFrom." .

mesh:SchemaDescription a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Schema Description" ;
  rdfs:comment "Column-level schema (fields, types, descriptions) returned by findSchema." .

mesh:FreshnessReport a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Freshness Report" ;
  rdfs:comment "Last-updated timestamp + SLA comparison returned by checkFreshness." .

mesh:TagFilterResult a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Tag Filter Result" ;
  rdfs:comment "Assets matching a tag query, returned by filterByTag." .

mesh:ImpactSet a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Impact Set" ;
  rdfs:comment "Downstream blast radius of a schema change, returned by assessImpact." .

# DECLARED HERE 2026-08-14 BECAUSE IT WAS DECLARED NOWHERE. mesh:proposeDisposition has
# named this as its output_uri since it woke, but no TTL ever declared the class — it
# existed only because scripts/seed_sandbox_predicates.py MERGEs (not MATCHes) its
# endpoint classes into being as a side effect of seeding the predicate. So sandbox had
# the node, every fresh cluster did not, and the registrar (which MATCHes, correctly, and
# must never invent ontology) refused the edge with a Contract D 422 that was telling the
# exact truth. Witnessed at work 2026-08-14: nine of Engine A's ten verbs registered and
# this one could not, permanently — a restart cannot conjure a class no source declares.
# The input side was never the problem: pcn:SustainmentNotice is properly declared in
# pcn_extension.ttl. See docs/plans/registration-boot-order-race.md.
mesh:DispositionReview a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Disposition Review" ;
  rdfs:comment "Output of proposeDisposition: a server-authored batch of per-part disposition proposals (dispatch-to-qualification / last-time-buy / alternate-sourcing / archive) for a sustainment notice, opened as ONE human review that fans out per-part dispatch tasks on approval." .

# =============================================================================
# PRESENTATION ARCHETYPES (added 2026-08-21) — the OBJECT end of a rendersAs
# triple, declared so it can exist.
# =============================================================================
#
# WHY THESE WERE MISSING, and why the gate was right. ADR-0017 registers a
# presentation capability as (subject_uri, mesh:rendersAs, object_uri) — the object
# being an ARCHETYPE IRI like mesh:ChartWidget. Those IRIs are referenced across the
# ADR, the capability table, and every registration Engine F emits at startup, and
# they were DECLARED NOWHERE. Contract D (ADR-0019) requires both triple endpoints to
# pre-exist as :OntologyClass nodes and deliberately refuses to auto-MERGE them,
# because the prior form fabricated phantom classes with no subClassOf edges and no
# provenance.
#
# So every presentation registration failed Contract D on its OBJECT end — correctly.
# Measured 2026-08-21 against the live substrate (7023 classes, targeted lookups): the
# SUBJECTS are all declared (mesh:OwnershipFact, mesh:DatasetAnalysisReport, …) and not
# one ARCHETYPE was. Same species as mesh:DispositionReview above: a URI named by a
# registration and declared by nothing — green in every conversation, impossible in
# every fresh substrate. Weakening the gate to let presentations through would have
# been fixing the alarm.
#
# A NOTE ON WHAT THESE ARE. An archetype is not a request and not a response — it is
# the RENDERING KIND a response can be presented as, so it hangs off its own parent
# rather than being forced under mesh:Response. The distinction is load-bearing at the
# graph level: mesh:DatasetAnalysisReport is a thing an engine PRODUCES;
# mesh:ChartWidget is a way a client can DRAW it. One is the payload, the other is the
# treatment.
#
# INERT UNTIL PRIMED. A TTL edit does not reach Neo4j by itself — these become
# :OntologyClass nodes on the next ontology ingest (prime → MinIO → Fuseki → Neo4j via
# doc-tools' sync_jena_ontologies_to_neo4j). Until that runs, the presentation sync
# still fails Contract D, and correctly so.

mesh:Archetype a owl:Class ;
  rdfs:subClassOf prov:Entity ;
  rdfs:label "Archetype" ;
  rdfs:comment "Abstract parent of presentation archetypes — a RENDERING KIND a response can be presented as, never a payload shape itself. The object end of a mesh:rendersAs triple." .

mesh:KnowledgeDocument a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Knowledge Document" ;
  rdfs:comment "Prose rendered as markdown. The UNIVERSAL archetype: its renderer accepts any string and publishes an EMPTY refusal vocabulary, which is why it is the fallback an unsatisfiable payload can always land on." .

mesh:ChartWidget a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Chart Widget" ;
  rdfs:comment "A plotted series. Requires rows carrying at least one numeric column; categorical-axis kinds additionally require a label column, and scatter requires two numeric columns. Refuses rather than drawing an undrawable payload." .

mesh:ProcessTopology a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Process Topology" ;
  rdfs:comment "A directed graph of steps and connectors — nodes carrying identity and edges carrying source and target." .

mesh:AssetStateMetric a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Asset State Metric" ;
  rdfs:comment "Tabular state or telemetry. Its renderer derives columns from the FIRST ROW, so heterogeneous rows lose the columns absent from it — a constraint on what a producer may send, not a display preference." .

mesh:HazardDeclaration a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Hazard Declaration" ;
  rdfs:comment "A safety or risk statement with an optional enumerated hazard list and a severity of CRITICAL, WARNING or INFO." .

# =============================================================================
# ENGINE P — PLANNING RESPONSE TYPES (added 2026-08-21)
# =============================================================================
#
# The SUBJECT end of Engine P's registrations. Ten verbs, ten fixed output types
# (ADR-0030), each declared here so Contract D can find it.
#
# WITHOUT THESE, every planning verb's registration fails on its subject end exactly as the
# archetypes below failed on their object end — and per the 2026-08-21 measurement, the
# failure reads as "incomplete" rather than "undeclared", which is the shape that costs an
# afternoon. Declared at the same time as the verbs rather than after them, because a verb
# that registers and cannot route is a promise with nothing behind it.
#
# NAMES ARE STRUCTURAL, not domain (GENERIC-AT-BIRTH). "PeriodCostSeries" is the closest any
# of these comes to a domain word and it is a shape — a series of amounts per period — not a
# portfolio-planning term. What the amounts MEAN rides in the payload.

mesh:PeriodCostSeries a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Period Cost Series" ;
  rdfs:comment "Amounts per fiscal period, split by kind, against an optional governed cap per period. The cap is NULLABLE and null means uncapped — never zero, which would read as a breached line." .

mesh:FundingGapSet a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Funding Gap Set" ;
  rdfs:comment "Required minus committed per group per period. Demand and supply are separate facts; a single combined figure cannot express a multi-funder shortfall." .

mesh:LoadThresholdGrid a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Load Threshold Grid" ;
  rdfs:comment "Measured value per subject per period against a threshold THAT SUBJECT OWNS. The threshold is per cell because it is a governance judgement attached to the subject; one line across the grid would mis-colour every subject whose line differs." .

mesh:ConstraintViolationSet a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Constraint Violation Set" ;
  rdfs:comment "Ordering constraints whose successor violates its type and lag, carrying the shortfall in days. A violation with no magnitude sends someone to open a schedule; one with a magnitude is actionable." .

mesh:MaturityMatrix a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Maturity Matrix" ;
  rdfs:comment "Subject-by-subject level against target from the latest append-only assessment at or before an as-of date. A cell never assessed is ABSENT, not zero — never-assessed and assessed-at-zero are different facts." .

mesh:ContributionSequence a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Contribution Sequence" ;
  rdfs:comment "Weighted contributors to an outcome ordered by completion, compared against dated milestones. Reports contributions OUTSTANDING past a date, never that the date was missed — the model carries no per-milestone requirement to support the stronger claim." .

mesh:PlateauTimeline a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Plateau Timeline" ;
  rdfs:comment "Dated states a process passes through, with the capabilities enabling it and their assessed trajectory." .

mesh:FootprintSet a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Footprint Set" ;
  rdfs:comment "Where a thing is used — the capabilities it enables and the work it participates in, with intervals." .

mesh:IntervalSchedule a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Interval Schedule" ;
  rdfs:comment "Flat rows carrying their parentage and planned versus actual intervals. Flat rather than nested because a flat set diffs cleanly against another state and a tree does not." .

mesh:ChangeLog a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Change Log" ;
  rdfs:comment "The ordered operations accumulated in a scenario. The record a decision is reconstructed from long after the session that produced it." .

mesh:EffectSet a owl:Class ;
  rdfs:subClassOf mesh:Response ;
  rdfs:label "Effect Set" ;
  rdfs:comment "The consequences of one state versus another, each carrying a direction (improved/degraded/neutral), a computed magnitude and the named things affected. Direction is a JUDGEMENT the producing measure owns — a set of raw deltas would hand interpretation back to the reader, which is the work this shape exists to remove. Constraint breaches are counted and never suppressed by a materiality floor; a floor that hid them would hide the thing most worth seeing." .

# --- the matching ARCHETYPES (object end) --------------------------------
# Live views (ADR-0042): their content is recomputed against mutable state rather than being
# born complete, and their contracts declare `recomputes: true` so the selector can identify
# them. Structural names — PERIOD_SERIES not COST_CURVE — because the archetype string is
# what registers, what the backend validates against, and what appears in every caller's menu.

mesh:PeriodSeries a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Period Series" ;
  rdfs:comment "A time-phased series drawn against an optional threshold line. Refuses a payload with no periods, an unlabelled row, or no numeric amount anywhere. A LIVE VIEW: content is replaced wholesale on re-evaluation and its freshness stamp is per evaluation, never inherited from mint time." .

# --- THE FOUR REVIEW ARCHETYPES -----------------------------------------------
# Registered by cortex-ui since before the presentation arc, declared NOWHERE until now — the
# same gap the chart and document archetypes had, surviving in the four that were converted
# last. Contract D refuses a rendersAs triple whose object end does not pre-exist, so every one
# of these registrations was being rejected on its object end, correctly, and the rejection
# reads as "incomplete" rather than "undeclared".
#
# Found by DERIVING the population rather than listing it: every `object_uri` in cortex-ui's
# DERIVED_BINDINGS, minus every `owl:Class` in this file. A hand-kept list would have found
# whichever ones someone remembered.

mesh:GroupedReview a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Grouped Review" ;
  rdfs:comment "A batch of affected items resolved in ONE approval action, with per-item overrides that each capture a reason. The grouping is the point: N items sharing a cause are one decision, and forcing N decisions is how a reviewer stops reading them. Items needing review are shown, never hidden." .

mesh:ApprovalTask a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Approval Task" ;
  rdfs:comment "A single accept-or-reject decision carried to whoever may act on it. The honest DEFAULT archetype for a task kind nothing else claims — an undeclared kind lands here rather than being silently guessed at." .

mesh:WorkflowObservation a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Workflow Observation" ;
  rdfs:comment "A read-only, entitlement-gated view of a running workflow: its stages, current position, steps and participants. Observer-facing by construction — redactions happen server-side before the projection is built, so the renderer never holds what the observer may not see." .

mesh:InstancesByProperty a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Instances By Property" ;
  rdfs:comment "Instances of a class filtered by one property, as a table. DOMAIN-AGNOSTIC BY CONSTRUCTION: the payload carries the columns, rows, row identity and state vocabulary, and the renderer knows none of them. The precedent every later generic archetype copies." .

mesh:DeltaSet a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Delta Set" ;
  rdfs:comment "Consequences grouped by direction — what improved, what degraded, each with a magnitude and the things it touched. Renders a comparison, never a state: the reader sees the PRICE of a change alongside its benefit, which a before-and-after of two states does not show. A LIVE VIEW." .

mesh:MatrixGrid a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Matrix Grid" ;
  rdfs:comment "Rows by columns of a level against a PER-CELL target. Distinct from mesh:ThresholdGrid on purpose: a threshold grid asks whether a value is over a line (a breach, read as danger); this asks how far a value is from a goal (a distance, read as progress), and one colour ramp cannot serve both readings. A cell never assessed is ABSENT, never level 0 — never-measured and measured-at-zero have different next actions. A LIVE VIEW." .

mesh:ThresholdGrid a owl:Class ;
  rdfs:subClassOf mesh:Archetype ;
  rdfs:label "Threshold Grid" ;
  rdfs:comment "Subjects by periods, each cell against a threshold the subject owns. Axes are DERIVED from the cells, so a pair with no activity renders as a gap rather than a zero — a zero in a heat grid reads as measured-and-fine, which is a different claim from nothing-was-happening. A LIVE VIEW." .
