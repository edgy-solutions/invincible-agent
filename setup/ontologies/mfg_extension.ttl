@prefix mfg:  <http://edgy-solutions.com/ontology/mfg#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix iof:  <https://spec.industrialontologies.org/ontology/core/Core/> .

mfg:MFG_Ontology a owl:Ontology ;
    rdfs:label "Manufacturing Extension Ontology" ;
    rdfs:comment "General manufacturing content-kind ontology. Parallel to the mil: extension's CONTENT KIND axis: subjects user questions about manufactured items resolve to. Kept GENERAL — a manufacturing work instruction can describe sensors, electronics, mechanical assemblies, munitions, etc. Per ADR-0021 the *what is described* (munitions / sensors / ...) is an instance-level concern, NOT a separate kind. Sub-kinds become warranted only when a routing question demands disambiguating them (Wave-3 discipline)." .

# ===========================================================================
# CONTENT KIND — the ROUTING-VISIBLE class.
#
# Single general kind today. Declared but HELD OUT OF THE ROUTING POOL until
# a verb is typed against it (ADR-0019 Wave-3 discipline — a kind enters the
# candidate pool only when verb coverage exists). The manufacturing extractor's
# INSTANCE_OF stamping (ADR-0021) targets THIS class.
#
# Sub-kinds (e.g. mfg:MunitionsAssemblyWorkInstruction,
# mfg:SensorAssemblyWorkInstruction) are intentionally NOT declared here —
# they would be premature ontology debt until a real routing question demands
# the disambiguation. The pre-canonical residue at
# http://example.com/manufacturing# (MunitionsAssemblyStep, ExplosivesSafetyHazard,
# etc.) is from a legacy direct-load and is being retired (Gap-1 durable fix,
# ADR-0021 Consequences).
# ===========================================================================

mfg:WorkInstruction a owl:Class ;
    rdfs:subClassOf iof:InformationContentEntity ;
    rdfs:label "Manufacturing Work Instruction" ;
    skos:definition "A unit of authored procedural manufacturing information — the steps, tools, consumables, hazards, and standards required to produce, assemble, or finish a manufactured artifact. The general kind: sensors, electronics, mechanical assemblies, and munitions are all DESCRIBED BY a manufacturing work instruction, not separate kinds of it." ;
    rdfs:comment "Routing subject for 'how is X manufactured', 'what are the assembly steps for X', and similar manufacturing-procedure queries. INSTANCE_OF target for the ManufacturingPlugin's extracted steps (ADR-0021)." .
