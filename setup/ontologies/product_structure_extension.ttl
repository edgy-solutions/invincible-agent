@prefix ps:    <http://internal/sustainment/product#> .
@prefix s3kl:  <http://www.lksoft.com/s3kl#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix mesh:  <http://invincible-agent/mesh#> .
@prefix iof-construct: <https://spec.industrialontologies.org/ontology/construct/> .

# ============================================================================
# CANONICAL PRODUCT-STRUCTURE VOCABULARY (ADR-0035 data plane)
#
# THE THESIS: this is not four BOM sources. It is ONE mirror of the authoritative
# PDM system with several degradation paths, each honest about its distance.
# The graph therefore speaks TRUTH'S language — the canonical shape — and every
# stopgap source declares a lossy mapping INTO it. Modelling from a source (a
# spreadsheet export, say) would inherit that export's omissions as STRUCTURAL
# ABSENCES, and a structural absence is the hardest debt to retire because
# nothing marks it as missing.
#
# VOCABULARY: S3000L (already in the prime manifest, sustainment/S3000L.ttl —
# 773 classes, 373 properties, verified in the live graph before this file was
# written). Every derivedFrom below cites a class/property CONFIRMED PRESENT.
#
# ANCESTRY, HONESTLY SCOPED: S3000L is architect-asserted to build on
# ISO 10303-239 (PLCS). That claim is NOT verified here and is NOT cited as a
# derivedFrom target — nothing in the ingested triples references ISO 10303.
# derivedFrom points at S3000L directly, which is verified. If ISO conformance
# is ever asked for, the trigger is to read S3000L's own normative-references
# section; see ADR-0035 "Standards context".
#
# WHAT STEP 0 CHANGED — the coverage check earned its cost twice:
#   * product structure is Breakdown / BreakdownElement, NOT Assembly/Component
#   * effectivity is APPLICABILITY (s3kl:ApplicabilityStatement)
# A model authored without reading the standard would have invented all three
# names and silently forfeited the citation while looking standards-aligned.
# (ps:Assembly and ps:EndItem, added by ADR-0065, do not undo this: both are
# subclasses of ps:Part, roles a part plays in the breakdown, and neither cites
# an S3000L name it does not have.)
#
# IOF CORE ALIGNMENT (ADR-0065, 2026-11-08): rdfs:subClassOf into IOF Core's
# construct namespace, where the class means the same thing; rdfs:seeAlso where
# IOF names the MATERIAL counterpart of a DESIGN-view class. Every IOF name used
# here was read in IOF Core as the prime fetches it (iofoundry/ontology master,
# core/Core.rdf, fetched 2026-11-08, sha256 7e44642681de…): the terms are
# declared under .../ontology/construct/, not .../core/Core/, which is only
# their rdfs:isDefinedBy. The prime pulls master UNPINNED, so this set is a
# reading on a date, not a pin (tests/test_product_structure_vocabulary.py).
# ============================================================================

ps: a owl:Ontology ;
    rdfs:label "Canonical product structure (sustainment)" ;
    rdfs:comment """One PDM mirror with several degradation paths. S3000L-derived where the
standard covers the need; house convention, labelled, where the process's semantics exceed
it. Never contort the process to fit a citation.""" ;
    owl:imports <http://www.lksoft.com/s3kl> .

# ── Part ────────────────────────────────────────────────────────────────────
# THE ONE PART NODE (ADR-0065 ruling 1). ps:Assembly and ps:EndItem are subclasses of this
# class, roles a part plays in a breakdown, never second nodes. The IPD's part and this one
# resolve to one identity through alias rows (ADR-0056, ADR-0067); a part number with a CAGE
# code is an alias of that identity, never another node.
#
# IOF CORE: a part number + revision is a DESIGN, so this is an iof-construct:DesignSpecification
# ("information content entity that prescribes something man-made"), not a MaterialArtifact.
# The serial-numbered unit built to it is the material artifact it prescribes
# (iof-construct:prescribes), which is the as_built / as_maintained world.
#
# These two notes are `#` comments, not rdfs:comment, on purpose: the class comment is embedded
# as retrieval input, and a sibling's name in it competes for that sibling's traffic
# (tests/routing/test_definitions_are_retrieval_input.py).
ps:Part a owl:Class ;
    rdfs:label "Part" ;
    rdfs:subClassOf iof-construct:DesignSpecification ;
    rdfs:comment """An internally-identified part. Identity + revision; usage lives on ps:PartUsage.

    DESIGN VIEW, DELIBERATELY. S3000L splits as-designed from as-maintained, and BOM where-used
    IS the design view: what the engineering structure says goes where — what PDM holds, what a
    change notice's affected-parts question runs against, what qualification dispatch consults.
    As-maintained (what is actually installed in serial-numbered units) is a genuinely different
    dataset we do not have and must not pretend to.

    SUPERSEDED IN PART (ADR-0065 ruling 2, 2026-11-07). This comment used to say fleet-
    configuration data would be a DISTINCT vocabulary. The ruling put the axis here instead:
    every usage states its ps:configuration (as_designed | as_built | as_maintained). The data
    is still absent: only as_designed has a source, and a where-used question asked of as_built
    or as_maintained is refused loudly, never answered as an empty table.""" ;
    rdfs:seeAlso iof-construct:prescribes ;
    mesh:derivedFrom s3kl:PartAsDesigned .

ps:Assembly a owl:Class ;
    rdfs:label "Assembly" ;
    rdfs:subClassOf ps:Part ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( ps:Part [ a owl:Restriction ;
                                       owl:onProperty ps:parentIn ;
                                       owl:someValuesFrom ps:PartUsage ] ) ] ;
    rdfs:comment """A part that is the parent of at least one usage. DEFINED, never asserted: a
    writer does not type a node Assembly, the breakdown makes it one. HOUSE CONVENTION, uncited:
    S3000L says Breakdown / BreakdownElement and has no Assembly class (see the header).
    iof-construct:Assembly is the MATERIAL assembly a unit built to this design is, hence seeAlso,
    not subClassOf.""" ;
    rdfs:seeAlso iof-construct:Assembly .

ps:EndItem a owl:Class ;
    rdfs:label "End item" ;
    rdfs:subClassOf ps:Part ;
    rdfs:comment """A part a program sustains as a whole: where a where-used walk stops.
    ASSERTED, never defined: being the top of a breakdown is not enough, because the same
    assembly can be an end item for one program and a component for another.

    THE PROGRAM IS DELIBERATELY NOT A PROPERTY HERE. Which program sustains an end item is
    declared per asset (ADR-0056 §8, ADR-0065 §4), so the impact table's program column is a
    join to that declaration. A program edge in this vocabulary would be a second source for it.

    HOUSE CONVENTION, uncited in S3000L. iof-construct:MaterialProduct is the material
    counterpart, hence seeAlso.""" ;
    rdfs:seeAlso iof-construct:MaterialProduct .

ps:partNumber a owl:DatatypeProperty ;
    rdfs:domain ps:Part ; rdfs:range xsd:string ;
    mesh:derivedFrom s3kl:partIdentifier_partNumber .

ps:revision a owl:DatatypeProperty ;
    rdfs:domain ps:Part ; rdfs:range xsd:string ;
    rdfs:comment """Revision as the source states it. NOT a version ordering — sources differ.

    HOUSE CONVENTION: part-level revision per PDM practice. NO S3000L TARGET — and the slot is
    empty ON PURPOSE. It briefly cited s3kl:BreakdownElementRevision, which was WRONG in review:
    that revisions a POSITION IN A BREAKDOWN STRUCTURE, revised when the structure reorganizes.
    Our revision belongs to the PART — part-number + revision is the identity unit this whole
    model keys on, revised when the DESIGN changes. Two different things revised for two
    different reasons, and the citation was adjacent enough to look grounded while tracing to a
    concept that does not mean what we mean. Adjacency is exactly what a citation cannot survive.

    NAMED WAKE: a real part-revision element may exist deeper in S3000L's 773 classes — it was
    not among the nine verified. Trigger for that reading task: the first compliance conversation
    that asks. Not a TODO; an honest empty with a condition.""" .

# ── PartUsage — REIFIED, and the reification is load-bearing ────────────────
ps:PartUsage a owl:Class ;
    rdfs:label "Part usage" ;
    rdfs:comment """One parent-uses-child assertion. REIFIED because (a) provenance rides on
every assertion (ADR-0035 §4) and an edge cannot carry a provenance block, and (b) two sources
may assert DIFFERENT usage for the same pair — which must be representable as two assertions
that disagree, not silently collapsed into one edge that the last writer wins.

THE USED-IN RELATION (ADR-0065): a usage says the child is used in the parent, with a quantity,
a reference designator and an applicability (effectivity), in one ps:configuration.""" ;
    # The material relation a usage describes is IOF Core's component-part-of-at-some-time
    # between units built to the two designs, hence the seeAlso below. Kept out of the comment
    # because the IRI's local name contains a sibling's label (retrieval-input guard).
    skos:altLabel "used in" ;
    rdfs:seeAlso iof-construct:componentPartOfAtSomeTime ;
    mesh:derivedFrom s3kl:BreakdownElementUsageInBreakdown .

ps:parentIn a owl:ObjectProperty ; owl:inverseOf ps:parent ;
    rdfs:comment "The usages a part is the parent of. Exists so ps:Assembly can be defined, not asserted." .

ps:parent a owl:ObjectProperty ; rdfs:domain ps:PartUsage ; rdfs:range ps:Part ;
    mesh:derivedFrom s3kl:Breakdown .
ps:child  a owl:ObjectProperty ; rdfs:domain ps:PartUsage ; rdfs:range ps:Part ;
    mesh:derivedFrom s3kl:BreakdownElement .
ps:quantity a owl:DatatypeProperty ; rdfs:domain ps:PartUsage ; rdfs:range xsd:decimal ;
    mesh:derivedFrom s3kl:quantityOfChildElement .
ps:referenceDesignator a owl:DatatypeProperty ; rdfs:domain ps:PartUsage ; rdfs:range xsd:string ;
    rdfs:comment "House convention — no confirmed S3000L element; left uncited deliberately." .

ps:applicability a owl:ObjectProperty ;
    rdfs:domain ps:PartUsage ;
    rdfs:comment """Effectivity, under the standard's own name. S3000L expresses 'when does
this usage apply' as APPLICABILITY, not 'effectivity' — adopting its term keeps the citation
and avoids a synonym nobody can trace.""" ;
    mesh:derivedFrom s3kl:ApplicabilityStatement .

# ── Configuration — the view a usage was asserted in (ADR-0065 ruling 2) ────
ps:Configuration a owl:Class ;
    rdfs:label "Configuration" ;
    owl:oneOf ( ps:as_designed ps:as_built ps:as_maintained ) ;
    rdfs:comment """Which view of the product a usage belongs to. A CLOSED set of three, ruled by
    ADR-0065 (the where-used verb's `configuration` argument and every impact row's column), so it
    is owl:oneOf here and not a registry: a deployment cannot add a fourth view of a product.
    Concept from EIA-649 and S3000L's as-designed / as-maintained split, cited, not copied.
    HOUSE CONVENTION: no S3000L element was verified for the axis itself, so it is uncited.""" .

ps:as_designed a ps:Configuration , owl:NamedIndividual ; rdfs:label "as designed" ;
    rdfs:comment "The engineering structure (EBOM): the only configuration any source has today." .
ps:as_built a ps:Configuration , owl:NamedIndividual ; rdfs:label "as built" ;
    rdfs:comment "What a serial-numbered unit was built with. No source yet: a configuration-management feed or a PDM mapping would be one." .
ps:as_maintained a ps:Configuration , owl:NamedIndividual ; rdfs:label "as maintained" ;
    rdfs:comment "What a unit carries now, after maintenance. No source yet." .

ps:configuration a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain ps:PartUsage ; rdfs:range ps:Configuration ;
    rdfs:comment """The configuration this usage was asserted in. One per usage: the same pair in two
    configurations is two usages, as two disagreeing sources are.

    NOT YET WRITABLE, ON PURPOSE. src/iagent/product_writer.py refuses a field its canonical set
    does not name, and this one is not in it yet. It joins that set, and the mapping template, with
    the BOM data contract (ADR-0066's second contract file). Until then every usage written came
    from the design view, which is why the verb's default is as_designed (ADR-0065 §4).""" .

# ── Approved-source bridge — HOUSE CONVENTION, enrichment over the standard ─
# RULED 2026-08-01. S3000L carries manufacturer part numbers as IDENTIFIER VARIANTS on a part
# (partIdentifier_oemPartNumber / _supplierPartNumber / _customerPartNumber). That shape cannot
# express what this system's own process manipulates:
#
#   * APPROVED SOURCING IS MANY-TO-MANY. One MPN qualified into several internal parts; one
#     internal part with several approved MPNs — the latter IS what an AML is.
#   * `dispatchQualification` LITERALLY MEANS "add an approved source". The disposition
#     workflow already dispatches it, and an identifier attribute gives that outcome no
#     first-class object to be written onto.
#   * PER-RELATIONSHIP PROVENANCE is required by ADR-0035 §4 — who qualified it, when, on what
#     evidence. An attribute on a part structurally cannot carry a provenance block.
#   * QUALIFICATION HAS A LIFECYCLE (pending / approved / last-time-buy-only) that has to land
#     somewhere.
#
# So this is an ENRICHMENT OVER the standard, not a fork FROM it: the manufacturer-part side
# ALSO populates s3kl:partIdentifier_oemPartNumber, so anything reading pure S3000L still sees
# the identifiers and only loses the relationship semantics it never had. That is the
# internal-maps-to-standard rule in its intended direction — adopt where the standard covers,
# house-convention-honestly-labelled where the process's semantics exceed it.
#
# FORWARD NOTE (empty-slot-with-a-wake): PLCS proper is asserted to carry richer
# product-supplier structure than S3000L's profile exposes. If that is confirmed, this bridge
# may earn a real ancestry citation. Wake: a compliance ask, or a second consumer needing it.

ps:ManufacturerPart a owl:Class ;
    rdfs:label "Manufacturer part" ;
    rdfs:comment "A manufacturer-identified part (the MPN a change notice names)." ;
    rdfs:seeAlso s3kl:partIdentifier_oemPartNumber .

ps:mpn a owl:DatatypeProperty ; rdfs:domain ps:ManufacturerPart ; rdfs:range xsd:string ;
    rdfs:comment "Co-populated to s3kl:partIdentifier_oemPartNumber by the writer." ;
    rdfs:seeAlso s3kl:partIdentifier_oemPartNumber .

ps:ApprovedSourceRelationship a owl:Class ;
    rdfs:label "Approved source relationship" ;
    rdfs:comment """HOUSE CONVENTION (no S3000L equivalent — see the block above). Reified
Part <-> ManufacturerPart with qualification status and its own provenance. NAMING AND THE
STATUS VOCABULARY ARE FLAGGED FOR THE AUTHORING SESSION — deliberately not settled here.""" .

ps:forPart          a owl:ObjectProperty ; rdfs:domain ps:ApprovedSourceRelationship ; rdfs:range ps:Part .
ps:forManufacturerPart a owl:ObjectProperty ; rdfs:domain ps:ApprovedSourceRelationship ; rdfs:range ps:ManufacturerPart .
ps:qualificationStatus a owl:DatatypeProperty ; rdfs:domain ps:ApprovedSourceRelationship ; rdfs:range xsd:string ;
    rdfs:comment "DRAFT vocabulary: pending | approved | last-time-buy-only. Settled at authoring." .

# ── Provenance, on every assertion (ADR-0035 §4) ────────────────────────────
# The claim that cannot say where it came from doesn't get written. Enforced at the WRITER
# (src/iagent/provenance.py), declared here so the shape is visible in the vocabulary.
ps:authoritativeSource a owl:DatatypeProperty ;
    rdfs:comment "Who OWNS the truth — the same value for every path to it." .
ps:obtainedVia a owl:DatatypeProperty ;
    rdfs:comment "The degradation path: direct | etl | warehouse | manual-export | user-drop (ADR-0041 §2)." .
ps:asOf a owl:DatatypeProperty ;
    rdfs:comment "Truth-date. 'unknown' is a SENTINEL, never a blank." ;
    mesh:derivedFrom prov:generatedAtTime .
ps:ingestRun a owl:DatatypeProperty ;
    rdfs:comment "Chains claim -> run -> sensor -> source object -> ETag." .
ps:standing a owl:DatatypeProperty ;
    rdfs:comment "The source's trust rung FROZEN at write time (ADR-0034 rungs)." .
ps:derivedFromSource a owl:ObjectProperty ;
    mesh:derivedFrom prov:wasDerivedFrom .

# ── Lifecycle status — what obsolescence intake writes (ADR-0065 §3) ────────
ps:LifecycleStatus a owl:Class ;
    rdfs:label "Lifecycle status" ;
    skos:altLabel "lifecycle_status" ;
    rdfs:subClassOf iof-construct:DescriptiveInformationContentEntity ;
    rdfs:comment """A part's supply-lifecycle status, as one source stated it on one date:
    {status, source, as_of, successor?}. REIFIED for the reason a usage is: it carries its
    own source and date, and two sources may disagree.

    ABSENT IS NOT NULL, and both readers and writers keep them apart:
      * a part with no ps:lifecycleStatus has NOT BEEN ASSESSED;
      * a ps:LifecycleStatus with no ps:status was ASSESSED, AND NONE IS KNOWN.

    Concept from IEC 62402 and EIA-724, cited, not copied. The disposition writer writes it in
    the same transaction as the rule match (ADR-0065 §2).""" .

ps:lifecycleStatus a owl:ObjectProperty ;
    rdfs:domain ps:Part ; rdfs:range ps:LifecycleStatus .

ps:status a owl:DatatypeProperty ;
    rdfs:domain ps:LifecycleStatus ; rdfs:range xsd:string ;
    rdfs:comment """A value from policy/registry/lifecycle_status.yaml (seed plus a deployment's
    overlay), validated as a plain string against the served registry. DELIBERATELY NOT an
    owl:oneOf here: the menu is data a deployment extends, and an enum in this file would be a
    second copy of it.""" .

ps:statusSource a owl:DatatypeProperty ;
    rdfs:domain ps:LifecycleStatus ; rdfs:range xsd:string ;
    rdfs:comment "The notice, feed or declaration the status came from. Its date is ps:asOf." .

ps:successor a owl:ObjectProperty ;
    rdfs:domain ps:LifecycleStatus ; rdfs:range ps:Part ;
    rdfs:comment "The replacement part's identity, when the source names one. Optional." .

# ── Last-time-buy decision — the action record of one resolution (ADR-0065 §5) ─
ps:LtbDecision a owl:Class ;
    rdfs:label "Last-time-buy decision" ;
    skos:altLabel "ltb_decision" ;
    rdfs:subClassOf iof-construct:PlanSpecification ;
    rdfs:comment """The action record of a last-time-buy resolution of the obsolescence_resolution
    workflow: {quantity, by, rationale, approved_by}. It prescribes a buy that has not happened yet,
    hence a PlanSpecification. The brief named the four fields without definitions; the
    definitions below are Lane 1's, built with D, for ruling. Concept from SD-22 / MIL-STD-3018,
    cited, not copied.""" .

ps:ltbFor a owl:ObjectProperty ;
    rdfs:domain ps:LtbDecision ; rdfs:range ps:Part ;
    rdfs:comment "The part the buy is for." .
ps:ltbQuantity a owl:DatatypeProperty ;
    rdfs:domain ps:LtbDecision ; rdfs:range xsd:decimal ;
    rdfs:comment "quantity: how many to buy, in the part's unit of issue." .
ps:ltbBy a owl:DatatypeProperty ;
    rdfs:domain ps:LtbDecision ; rdfs:range xsd:date ;
    rdfs:comment "by: the date the order must be placed by, usually the notice's last-order date. A date, not a person." .
ps:ltbRationale a owl:DatatypeProperty ;
    rdfs:domain ps:LtbDecision ; rdfs:range xsd:string ;
    rdfs:comment "rationale: why this quantity, in the decider's words." .
ps:ltbApprovedBy a owl:DatatypeProperty ;
    rdfs:domain ps:LtbDecision ; rdfs:range xsd:string ;
    rdfs:comment "approved_by: the approver's identity (authz_id), from the task_grants approver audience." .

# ── Deliberately OUT of v1, each waking on its consumer ─────────────────────
# CAD structure · alternates / substitution groups · full effectivity algebra.
# Named so their absence is a decision on the record rather than an oversight.
