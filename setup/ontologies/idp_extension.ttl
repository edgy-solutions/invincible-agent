@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix idp:   <http://invincible-agent/idp#> .

<http://internal/data_engineering> a owl:Ontology ;
    rdfs:label "IDP / Data Engineering domain extension" ;
    rdfs:comment "Thin extension declaring the concrete user-facing nouns for catalog queries. Subclass under prov:Entity (PROV-O backbone). Closes the Contract D debt for the 10 catalog verbs once they re-type to idp:* subjects in Phase 5. Dataset and Dashboard definitions are VERBATIM-TRANSCRIBED from the existing hand-curated data:* classes so the resolver's hybrid search lands on the new full-IRI form at the same confidence." .

# Note: doc_tools.assets.ontology_assets.ingest_ontology_to_jena uses a
# SPARQL UNION over { skos:definition } UNION { rdfs:comment } and the
# Weaviate sync upserts by deterministic UUID per URI, so the last-row
# wins. rdfs:comment is what reliably lands in Weaviate.OntologyClass.definition.
# Therefore the user-facing definition goes in rdfs:comment ONLY — no
# skos:definition that would silently get clobbered. Spec / hierarchy /
# routing notes live in STEP0_IDP_BUILD_SPEC.md, not in the TTL.

# ---------------------------------------------------------------------------
# Data assets — concrete catalog subjects
# ---------------------------------------------------------------------------

idp:Dataset a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Dataset" ;
    rdfs:comment "A catalog-tracked dataset, table, view, or chart in DataHub. Queries about ownership, schema, lineage, freshness, tags, catalog enumeration, or asset profiles target this class. Examples: tables, datasets, dashboards, charts in the data warehouse." .

idp:Table a owl:Class ;
    rdfs:subClassOf idp:Dataset ;
    rdfs:label "Table" ;
    rdfs:comment "A relational table within a database or warehouse — a concrete tabular Dataset with rows and columns. Queries about ownership, schema, lineage, freshness, tags, or asset profiles of a specific table target this class. Inherits all catalog operations from idp:Dataset." .

idp:Dashboard a owl:Class ;
    rdfs:subClassOf idp:Dataset ;
    rdfs:label "Dashboard" ;
    rdfs:comment "A dashboard in the analytics catalog. Subtype of Dataset for catalog-routing purposes." .

# DEFINITIONS ARE THE RECALL SIGNAL — write them for the class, never for the query.
#
# Measured 2026-08-15: recall ranked idp:Column top on identifier-shaped queries it had no
# business winning ("publog.p_cage", "minio-svc.publog-lake/publog/p_cage"), and the LLM had
# to override it — correctly — on 5 of 6 disagreements. The cause was in this file, not in
# the classifier. Weaviate embeds "<label> — <definition>", so two habits poisoned the score:
#
#   1. QUERY-SHAPED EXAMPLES. This comment used to carry two quoted user questions ("what
#      feeds the revenue column", "which dashboards use the orders.amount column"). A user's
#      question was being scored against a definition MADE OF QUESTIONS, which inflates
#      similarity for any question at all. `orders.amount` was worse still: a dotted
#      identifier, so every dotted asset name in a query resembled it.
#   2. SIBLING-NAME BLEED. It also named Table, Dataset and dashboards, so it competed for
#      its siblings' traffic.
#
# Definitions now describe WHAT THE CLASS IS and, where the boundary is genuinely confusable,
# what it is NOT. No quoted queries, no example identifiers, no sibling class names used as
# filler. Concrete product names (Airflow, dbt, Dagster) are FINE — they name the thing, they
# do not imitate the question.
idp:Column a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Column" ;
    rdfs:comment "A single named field within a tabular asset, carrying its own data type, nullability and description. Queries about one field's type, lineage, quality, or downstream consumers target this class — as opposed to questions about the containing asset as a whole, which do not." .

# ---------------------------------------------------------------------------
# Data activities — processes and jobs
# ---------------------------------------------------------------------------

idp:Pipeline a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Pipeline" ;
    # "Datasets" and "source datasets" removed — sibling-name bleed. This definition ranked
    # top for "list the datasets in publog", a question squarely about idp:Dataset, purely
    # because it named that class twice. "data assets" and "inputs" carry the same meaning
    # without competing for another class's traffic.
    rdfs:comment "A DAG of data-engineering tasks (Airflow DAG, dbt project, Dagster job-set) that produces or transforms data assets. Queries about pipeline structure, schedule, owner, inputs, or downstream consumers target this class." .

idp:Job a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Job" ;
    rdfs:comment "A single execution unit (Dagster op, dbt model run, Airflow task) within a Pipeline. Queries about last execution time, run history, alerts, or failures of a specific job target this class." .
